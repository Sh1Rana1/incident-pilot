# 必填：服务商密钥、OpenAI 兼容地址、模型 ID
API_KEY=your_api_key_here
BASE_URL=https://api.openai.com/v1
MODEL=gpt-5.4-mini

# 通常保持 auto；遇到特殊兼容服务时才覆盖。
# OUTPUT_MODE: auto / json_schema / json_object / text
OUTPUT_MODE=auto
# STRICT_TOOLS: auto / true / false
STRICT_TOOLS=auto

# V8.1.1 调查硬预算。模型预算包含调查、强制总结和格式修复。
MAX_MODEL_CALLS=10
MAX_TOOL_CALLS=20
MAX_TOOLS_PER_STEP=3

# 仅交互式 main.py 开启 HITL；Evaluation 默认不暂停。
HITL_MODEL_CALL_THRESHOLD=5
HITL_TOOL_CALL_THRESHOLD=10

# V9 受限 Runtime 工具。默认关闭；开启后，交互式 CLI 每次执行前仍会询问。
# 它只能运行预登记的 demo_app 案例，不能执行任意 Shell 命令。
ENABLE_RUNTIME_TOOLS=false
MAX_RUNTIME_CALLS=1
RUNTIME_TIMEOUT_SECONDS=5
